# Copy to .env.local and adjust. Never commit .env.local.

# --- Owner/superuser connection: ONLY for `db:migrate`, `db:seed`, `db:reset` and tests. ---
# The running app never uses it. Local Postgres 17 (cluster in ../db/pgdata, port 5433).
DATABASE_URL=postgres://postgres@localhost:5433/inventario
# Separate database used only by `npm test` (created/migrated automatically)
TEST_DATABASE_URL=postgres://postgres@localhost:5433/inventario_test

# --- Runtime connections (least privilege; the app uses ONLY these) ---
# Roles are created NOLOGIN by migration 009; `npm run db:migrate` turns on LOGIN and sets
# the password found here. Use long random passwords (and scram-sha-256 in pg_hba.conf
# for any non-local deployment: with `trust` auth the password is not even checked).
DATABASE_URL_SELLER=postgres://app_runtime_seller:CHANGE-ME-seller@localhost:5433/inventario
DATABASE_URL_SUPERADMIN=postgres://app_runtime_superadmin:CHANGE-ME-superadmin@localhost:5433/inventario
DATABASE_URL_AUTH=postgres://app_runtime_auth:CHANGE-ME-auth@localhost:5433/inventario

# --- Secrets (each >= 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Signs session cookies.
SESSION_SECRET=change-me-to-a-long-random-string-of-32+-chars
# Signs the per-request identity verified by the database (stored in app_private.settings).
DB_CONTEXT_SECRET=change-me-to-another-long-random-string-32+

# --- Optional hardening / behaviour ---
# Secure flag of the session cookie. Defaults to true in production; set false only for
# plain-http staging such as `next start` on localhost.
# COOKIE_SECURE=true
# Number of trusted reverse proxies in front of the app. When unset, X-Forwarded-For is
# ignored (it is client-controlled) and login throttling falls back to per-username only.
# TRUST_PROXY=1
# bcrypt work factor for new passwords (default 12). Tests use 4.
# BCRYPT_COST=12

# --- Initial passwords for the development seed (`npm run db:seed` / `db:reset`) ---
# >= 12 characters. If unset the seed generates random ones and prints them once.
# The Playwright e2e reads the same variables from .env.local.
# Username of the seeded superadmin (default "naty"). Stored lowercase; login ignores case.
# SEED_SUPERADMIN_USERNAME=naty
# SEED_SUPERADMIN_PASSWORD=<SUPERADMIN_PASSWORD>
# SEED_SELLER_PASSWORD=<SELLER_PASSWORD>

# --- Store (Etapa 2) ---
# Anonymous store traffic. Role created NOLOGIN by migration 019; `db:migrate` enables LOGIN with this password.
# It can ONLY execute the public_*() functions (no table access at all).
DATABASE_URL_PUBLIC=postgres://app_runtime_public:CHANGE-ME-public@localhost:5433/inventario
# HMAC key (>= 32 chars) that derives the buyer's order link token. Do NOT reuse SESSION_SECRET.
ORDER_TOKEN_SECRET=change-me-to-a-third-long-random-string-32+
# Optional: public origin for sitemap / OpenGraph (Vercel's production URL is used when unset).
# SITE_URL=https://tienda.example.com

# Origen permitido para la landing de Nova Bella (sin slash al final); no es un secreto.
NOVA_BELLA_LANDING_ORIGIN=https://nova-bella-boutique-2026.keenorbit34.chatgpt.site
